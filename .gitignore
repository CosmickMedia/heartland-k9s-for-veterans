node_modules/
.idea/
.DS_Store
dist/heartland-k9s-payload.zip
payload/media/
payload/source/
# evidence screenshots are committed (handoff kit); raw per-engine full-page duplicates and raw Lighthouse JSON are not
docs/reports/screenshots/cross-engine/
docs/reports/lighthouse/*.json
tools/.cache/
theme/heartland-k9s/assets/dist/*.map
*.log
docker/.env

# registry records contain personal contact data — generated locally, never committed
payload-src/records/barkode/
payload-src/source/
payload/manifest.json
payload/content/
payload/media-index.json

# Content-only ("lite") payload — tools/build-payload.mjs --lite. Only payload-lite/media/ (the 6 ref
# assets, ~1 MB) is committed so a clone can package the lite ZIP after `node tools/build-payload.mjs --lite`;
# manifest.json + content/ carry the same BarKode registry records as payload/ (personal contact
# data) and are generated locally, never committed — the packaged lite ZIP contains them too.
payload-lite/manifest.json
payload-lite/content/
dist/heartland-k9s-payload-lite.zip
